rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (Pillar 2: Anti-Update-Gap)

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'membershipTier', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'membershipTier', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() >= 0 && data.photoURL.size() <= 500
        && data.membershipTier is string && data.membershipTier.size() >= 1 && data.membershipTier.size() <= 32
        && (data.membershipTier == 'Standard' || data.membershipTier == 'Atelier Member' || data.membershipTier == 'Archive Collector')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'phone',
          'shippingAddress',
          'shippingCity',
          'shippingPostalCode',
          'shippingCountry',
          'preferredSizeShoe',
          'preferredSizeApparel',
          'savedCardLast4',
          'savedCardBrand',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'phone',
          'shippingAddress',
          'shippingCity',
          'shippingPostalCode',
          'shippingCountry',
          'preferredSizeShoe',
          'preferredSizeApparel',
          'savedCardLast4',
          'savedCardBrand',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.phone is string && data.phone.size() >= 0 && data.phone.size() <= 40
        && data.shippingAddress is string && data.shippingAddress.size() >= 0 && data.shippingAddress.size() <= 200
        && data.shippingCity is string && data.shippingCity.size() >= 0 && data.shippingCity.size() <= 80
        && data.shippingPostalCode is string && data.shippingPostalCode.size() >= 0 && data.shippingPostalCode.size() <= 24
        && data.shippingCountry is string && data.shippingCountry.size() >= 0 && data.shippingCountry.size() <= 60
        && data.preferredSizeShoe is string && data.preferredSizeShoe.size() >= 0 && data.preferredSizeShoe.size() <= 16
        && data.preferredSizeApparel is string && data.preferredSizeApparel.size() >= 0 && data.preferredSizeApparel.size() <= 16
        && data.savedCardLast4 is string && data.savedCardLast4.size() >= 0 && data.savedCardLast4.size() <= 4
        && data.savedCardBrand is string && data.savedCardBrand.size() >= 0 && data.savedCardBrand.size() <= 32
        && data.updatedAt is timestamp;
    }

    function isValidShipmentStatus(status) {
      return status is string && status.size() >= 2 && status.size() <= 40 && (
        status == 'Order Confirmed' ||
        status == 'Quality Inspection' ||
        status == 'Dispatched from Atelier' ||
        status == 'In Transit' ||
        status == 'Out for Delivery' ||
        status == 'Delivered'
      );
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber',
          'userId',
          'customerName',
          'shippingAddressSummary',
          'shippingCity',
          'shippingPostalCode',
          'shippingCountry',
          'paymentMethod',
          'paymentLast4',
          'paymentStatus',
          'subtotal',
          'shippingFee',
          'totalAmount',
          'itemCount',
          'primaryItemTitle',
          'primaryItemImage',
          'shipmentStatus',
          'carrier',
          'trackingNumber',
          'currentHub',
          'destinationHub',
          'estimatedDelivery',
          'progressPercent',
          'lastStatusNote',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber',
          'userId',
          'customerName',
          'shippingAddressSummary',
          'shippingCity',
          'shippingPostalCode',
          'shippingCountry',
          'paymentMethod',
          'paymentLast4',
          'paymentStatus',
          'subtotal',
          'shippingFee',
          'totalAmount',
          'itemCount',
          'primaryItemTitle',
          'primaryItemImage',
          'shipmentStatus',
          'carrier',
          'trackingNumber',
          'currentHub',
          'destinationHub',
          'estimatedDelivery',
          'progressPercent',
          'lastStatusNote',
          'createdAt',
          'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.shippingAddressSummary is string && data.shippingAddressSummary.size() >= 5 && data.shippingAddressSummary.size() <= 240
        && data.shippingCity is string && data.shippingCity.size() >= 2 && data.shippingCity.size() <= 80
        && data.shippingPostalCode is string && data.shippingPostalCode.size() >= 2 && data.shippingPostalCode.size() <= 24
        && data.shippingCountry is string && data.shippingCountry.size() >= 2 && data.shippingCountry.size() <= 60
        && data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 32
        && (data.paymentMethod == 'Card' || data.paymentMethod == 'Express Pay' || data.paymentMethod == 'Cash on Delivery')
        && data.paymentLast4 is string && data.paymentLast4.size() >= 0 && data.paymentLast4.size() <= 4
        && data.paymentStatus is string && data.paymentStatus.size() >= 2 && data.paymentStatus.size() <= 32
        && (data.paymentStatus == 'Paid' || data.paymentStatus == 'Authorized' || data.paymentStatus == 'COD Pending' || data.paymentStatus == 'Refunded')
        && (data.subtotal is int || data.subtotal is float) && data.subtotal >= 0 && data.subtotal <= 1000000
        && (data.shippingFee is int || data.shippingFee is float) && data.shippingFee >= 0 && data.shippingFee <= 10000
        && (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0 && data.totalAmount <= 1010000
        && data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 100
        && data.primaryItemTitle is string && data.primaryItemTitle.size() >= 1 && data.primaryItemTitle.size() <= 120
        && data.primaryItemImage is string && data.primaryItemImage.size() >= 1 && data.primaryItemImage.size() <= 300
        && isValidShipmentStatus(data.shipmentStatus)
        && data.carrier is string && data.carrier.size() >= 2 && data.carrier.size() <= 60
        && data.trackingNumber is string && data.trackingNumber.size() >= 6 && data.trackingNumber.size() <= 40 && data.trackingNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && data.currentHub is string && data.currentHub.size() >= 2 && data.currentHub.size() <= 100
        && data.destinationHub is string && data.destinationHub.size() >= 2 && data.destinationHub.size() <= 100
        && data.estimatedDelivery is string && data.estimatedDelivery.size() >= 4 && data.estimatedDelivery.size() <= 60
        && data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.lastStatusNote is string && data.lastStatusNote.size() >= 2 && data.lastStatusNote.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderItem(data, orderId) {
      return data.keys().hasAll([
          'orderId',
          'userId',
          'productId',
          'title',
          'category',
          'size',
          'colorway',
          'unitPrice',
          'quantity',
          'imageUrl',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'orderId',
          'userId',
          'productId',
          'title',
          'category',
          'size',
          'colorway',
          'unitPrice',
          'quantity',
          'imageUrl',
          'createdAt'
        ])
        && data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.orderId == orderId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 64 && data.productId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 32
        && (data.category == 'Sneakers' || data.category == 'Apparel')
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 20
        && data.colorway is string && data.colorway.size() >= 1 && data.colorway.size() <= 60
        && (data.unitPrice is int || data.unitPrice is float) && data.unitPrice >= 0 && data.unitPrice <= 100000
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 50
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidShipmentEvent(data, orderId) {
      return data.keys().hasAll([
          'orderId',
          'userId',
          'statusStage',
          'location',
          'description',
          'timestampLabel',
          'stepIndex',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'orderId',
          'userId',
          'statusStage',
          'location',
          'description',
          'timestampLabel',
          'stepIndex',
          'createdAt'
        ])
        && data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.orderId == orderId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && isValidShipmentStatus(data.statusStage)
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 100
        && data.description is string && data.description.size() >= 2 && data.description.size() <= 240
        && data.timestampLabel is string && data.timestampLabel.size() >= 2 && data.timestampLabel.size() <= 60
        && data.stepIndex is int && data.stepIndex >= 0 && data.stepIndex <= 5
        && data.createdAt is timestamp;
    }

    // 4. Collection Match Blocks

    // Public/General User Profile (Non-PII)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'membershipTier', 'updatedAt']);
      allow delete: if false;

      // Isolated PII Subcollection (Pillar 6 Split Collection Strategy)
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && docId == 'info';
        allow list: if false;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email',
            'phone',
            'shippingAddress',
            'shippingCity',
            'shippingPostalCode',
            'shippingCountry',
            'preferredSizeShoe',
            'preferredSizeApparel',
            'savedCardLast4',
            'savedCardBrand',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if false;
      }
    }

    // Orders Collection (Master Source of Truth for Shipments)
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().shipmentStatus == 'Order Confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().subtotal == existing().subtotal
        && incoming().shippingFee == existing().shippingFee
        && incoming().totalAmount == existing().totalAmount
        && incoming().itemCount == existing().itemCount
        && incoming().trackingNumber == existing().trackingNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().shipmentStatus != 'Delivered'
        && (
          // Action 1: Advance real-time shipment telemetry
          incoming().diff(existing()).affectedKeys().hasOnly([
            'shipmentStatus',
            'currentHub',
            'progressPercent',
            'lastStatusNote',
            'paymentStatus',
            'updatedAt'
          ]) ||
          // Action 2: Update delivery address notes while still in Order Confirmed stage
          (
            existing().shipmentStatus == 'Order Confirmed' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'shippingAddressSummary',
              'shippingCity',
              'shippingPostalCode',
              'lastStatusNote',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;

      // Order Line Items Subcollection (Pillar 1 Master Gate)
      match /items/{itemId} {
        allow get: if isSignedIn()
          && isValidId(orderId)
          && isValidId(itemId)
          && existing().userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
        allow list: if isSignedIn()
          && existing().userId == request.auth.uid
          && existing().orderId == orderId;
        allow create: if isVerifiedUser()
          && isValidId(orderId)
          && isValidId(itemId)
          && isValidOrderItem(incoming(), orderId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // Order Shipment Telemetry Events Subcollection (Pillar 1 Master Gate)
      match /events/{eventId} {
        allow get: if isSignedIn()
          && isValidId(orderId)
          && isValidId(eventId)
          && existing().userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
        allow list: if isSignedIn()
          && existing().userId == request.auth.uid
          && existing().orderId == orderId;
        allow create: if isVerifiedUser()
          && isValidId(orderId)
          && isValidId(eventId)
          && isValidShipmentEvent(incoming(), orderId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/orders/$(orderId))
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
